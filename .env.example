# --- Contact form email (Resend) ---
# Create a free account at https://resend.com, then:
#   1. Add and verify the navous.app domain (Domains -> Add Domain -> add the
#      SPF/DKIM/DMARC DNS records Resend shows you). Required to email arbitrary
#      recipients (the lead's confirmation receipt).
#   2. Create an API key (API Keys -> Create) and paste it below.
RESEND_API_KEY=

# Where new lead notifications are delivered (your team inbox).
# Defaults to mike@navous.app in code if unset.
NOTIFICATION_EMAIL=mike@navous.app

# Verified sender on the navous.app domain (verified in Resend).
# Defaults to "Navous <noreply@navous.app>" in code if unset.
CONTACT_FROM_EMAIL="Navous <noreply@navous.app>"
